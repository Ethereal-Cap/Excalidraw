    {
      "id": "H8RQshMTXgVxEvXbbR_Wg",
      "type": "text",
      "x": 2429.4138141314024,
      "y": 595.061888112639,
      "width": 202.80775129291368,
      "height": 105,
      "angle": 0,
      "strokeColor": "#fde68a",
